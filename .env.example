# Copy this to .env and fill in values
# On Railway, set these as environment variables in the dashboard

# Environment Settings
ENVIRONMENT=production

# Django Security (generate a new secret key for production)
# Use: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here

# Database Configuration (Supabase PostgreSQL)
DB_NAME=postgres
DB_USER=postgres.ezrxfodgrztlajiiilfz
DB_PASSWORD=your-db-password-here
DB_HOST=aws-1-ap-northeast-1.pooler.supabase.com
DB_PORT=6543

# Railway sets this automatically — add your Railway domain here
ALLOWED_HOSTS=your-app.up.railway.app

# PayMongo Payment Gateway (Required for online payments)
# Get from: https://dashboard.paymongo.com/developers
PAYMONGO_SECRET_KEY=sk_test_or_live_key_here
PAYMONGO_PUBLIC_KEY=pk_test_or_live_key_here
# Webhook Secret for signature verification (from PayMongo Dashboard > Webhooks)
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Resend Email API (Required for email notifications)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
DEFAULT_FROM_EMAIL=REALESTATE360+ <noreply@realestate360.site>

# Gmail SMTP (Legacy - not used by tenant/lease emails; use Resend instead)
EMAIL_HOST_USER=johnarvint999@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
